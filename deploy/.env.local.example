# Settings for the production-like stack on a workstation or CI runner
# (docker-compose.prod.yml + deploy/docker-compose.local.yml). Copy to deploy/.env.local.
# Every value here is a throwaway for a machine that is not reachable from the internet.
# deploy/scripts/local-stack.sh creates the file with fresh random secrets if it is missing.

API_DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
WEB_PORT=8081
PUBLIC_API_URL=https://localhost:8443
CLIENT_ORIGIN=http://localhost:8081

POSTGRES_USER=airwatch
POSTGRES_DB=airwatch
POSTGRES_PASSWORD=
JWT_SECRET=
SIMULATOR_TOKEN_SECRET=

SIMULATOR_ENABLED=true
SIMULATOR_BATCH_MINUTES=1
BACKGROUND_PROVIDER=simulated
WEATHER_PROVIDER=simulated

SEED_DEMO_USERS=true
DEMO_CITIZEN_PASSWORD=
DEMO_OFFICER_PASSWORD=

# The stand-in artifact (see deploy/model/build_local_artifact.py). Use configs/config.yaml
# when the team's artifact is in adaptive-aqi-model/models/.
MODEL_CONFIG_PATH=models/local-demo/config.yaml

# S3Mock stands in for S3. It accepts any key, so these two are placeholders, not AWS keys.
AWS_REGION=ap-south-1
ATTACHMENT_STORAGE=s3
S3_BUCKET=airwatch-local-evidence
S3_ENDPOINT=http://objects:9090
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
