# Copy to deploy/.env.production on the server and fill in. Never commit the filled-in file.
# deploy/scripts/init-env.sh does both: it copies this file and generates every secret on the
# server itself, so no secret ever exists on a laptop or in the repository.

# Public HTTPS host name of the API. Must resolve to this server (see docs/DEPLOY_AWS.md).
API_DOMAIN=api.example.com
# Origin(s) of the frontend allowed to call the API, comma-separated. No trailing slash.
CLIENT_ORIGIN=https://main.xxxxxxxx.amplifyapp.com

POSTGRES_USER=airwatch
POSTGRES_DB=airwatch
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 48
JWT_SECRET=
# openssl rand -hex 32   (credentials of the simulated devices are derived from this)
SIMULATOR_TOKEN_SECRET=

# Device simulator and simulated context sources (the only sources that exist today).
SIMULATOR_ENABLED=true
SIMULATOR_BATCH_MINUTES=1
BACKGROUND_PROVIDER=simulated
WEATHER_PROVIDER=simulated

# Demo logins (citizen@airwatch.test, officer@airwatch.test, inspector@airwatch.test).
# If enabled, both passwords below are required: the development defaults are never used in production.
SEED_DEMO_USERS=true
# openssl rand -base64 12
DEMO_CITIZEN_PASSWORD=
DEMO_OFFICER_PASSWORD=

# Which model serving configuration to load, relative to adaptive-aqi-model/.
# configs/config.yaml expects the team's artifact models/delhi_pm10_calibrated.joblib.
# models/local-demo/config.yaml is the labelled stand-in built by deploy/model/build_local_artifact.py.
MODEL_CONFIG_PATH=configs/config.yaml

# --- AWS (leave the block as it is to run without AWS services) ---
AWS_REGION=ap-south-1
# Photographs: "database" keeps them in PostgreSQL, "s3" in the private bucket below.
ATTACHMENT_STORAGE=database
S3_BUCKET=
# Access key of the instance's IAM user (stack output InstanceUserName). It may only write to
# the bucket and to the log group. deploy/aws/deploy-backend.sh creates the key and fills
# these two lines in on the host.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Used by the CloudWatch overlay (deploy/docker-compose.cloudwatch.yml).
CLOUDWATCH_LOG_GROUP=/airwatch/prod
