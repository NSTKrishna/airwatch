# Copy to deploy/.env.production on the server and fill in. Never commit the filled-in file.

# Public HTTPS host name of the API. Must resolve to this server (see docs/DEPLOY_AWS.md).
API_DOMAIN=api.example.com
# Origin(s) of the frontend allowed to call the API, comma-separated. No trailing slash.
CLIENT_ORIGIN=https://main.xxxxxxxx.amplifyapp.com

POSTGRES_USER=airwatch
POSTGRES_DB=airwatch
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 48
JWT_SECRET=
# openssl rand -hex 32   (credentials of the simulated devices are derived from this)
SIMULATOR_TOKEN_SECRET=

# Device simulator and simulated context sources (the only sources that exist today).
SIMULATOR_ENABLED=true
SIMULATOR_BATCH_MINUTES=1
BACKGROUND_PROVIDER=simulated
WEATHER_PROVIDER=simulated

# Demo logins (citizen@airwatch.test, officer@airwatch.test, inspector@airwatch.test).
# If enabled, both passwords below are required: the development defaults are never used in production.
SEED_DEMO_USERS=true
DEMO_CITIZEN_PASSWORD=
DEMO_OFFICER_PASSWORD=

# Only for the CloudWatch overlay.
AWS_REGION=ap-south-1
CLOUDWATCH_LOG_GROUP=/airwatch/prod
