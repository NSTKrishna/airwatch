# Public entry point. Caddy obtains and renews the TLS certificate automatically.
# Only /api is exposed; PostgreSQL and the model service are not reachable from outside.
{$API_DOMAIN} {
	encode gzip
	request_body {
		max_size 25MB
	}
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		respond "Not found" 404
	}
	log {
		output stdout
		format json
	}
}
