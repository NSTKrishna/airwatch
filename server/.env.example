# Express API
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://USER@127.0.0.1:5432/airwatch?schema=public"
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# Existing FastAPI model service (adaptive-aqi-model). Never modified by this app.
MODEL_API_URL=http://127.0.0.1:8001
MODEL_TIMEOUT_MS=5000

# Sensor source, always labelled SIMULATED:
#   replay = the synthetic Delhi PM10 dataset replayed hour by hour (needs data/delhi_four_site_pm10_synthetic.csv)
#   mock   = generated readings, no dataset needed
SENSOR_PROVIDER=replay
# DATASET_CSV_PATH=/absolute/path/to/delhi_four_site_pm10_synthetic.csv
# Seconds between monitoring sweeps (0 disables the scheduler).
MONITOR_INTERVAL_SECONDS=60
# A site counts as "actively flagged" if its latest evaluation is an anomaly no older than this.
ACTIVE_ANOMALY_WINDOW_SECONDS=900
