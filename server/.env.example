# Express API
PORT=4000
# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL="postgresql://USER@127.0.0.1:5432/airwatch?schema=public"
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# Existing FastAPI model service (adaptive-aqi-model). Never modified by this app.
MODEL_API_URL=http://127.0.0.1:8001
MODEL_TIMEOUT_MS=5000

# Context sources for the PM10 model: simulated | none.
# With "none" readings are stored but never evaluated. Simulated context is never paired with real devices.
BACKGROUND_PROVIDER=simulated
WEATHER_PROVIDER=simulated

# Device simulator. It uploads through the same ingestion API as real devices.
# true runs it inside the API process (development). In production run `node src/worker.js` instead.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=60
# 1 = send every reading as it is taken; 15 = hold readings and upload a 15-minute batch.
SIMULATOR_BATCH_MINUTES=1
SIMULATOR_SEED=airwatch-demo
# Simulated devices derive their credentials from this; only hashes reach the database. 32+ characters.
SIMULATOR_TOKEN_SECRET=change-me-to-a-long-random-string-0000
# Required for the stand-alone simulator (worker): where the API lives.
# SIMULATOR_INGEST_URL=http://127.0.0.1:4000

# A site counts as "actively flagged" if its latest evaluation is an anomaly no older than this.
ACTIVE_ANOMALY_WINDOW_SECONDS=900
