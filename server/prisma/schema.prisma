generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  MUNICIPAL
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  INSPECTION_ASSIGNED
  RESOLVED
  REJECTED
}

// EVALUATED is the only status that carries a model verdict. Every other status
// means "no assessment was produced" and must never be shown as normal/anomalous.
enum EvaluationStatus {
  EVALUATED
  INPUT_REJECTED
  MODEL_UNAVAILABLE
  MODEL_ERROR
}

// Where a measurement came from. SIMULATED data is never presented as real.
enum DataProvenance {
  SIMULATED
  DEVICE    // authenticated physical monitor
  REFERENCE // approved reference station or weather service
}

enum DeviceStatus {
  ACTIVE
  DISABLED
}

enum ReadingQuality {
  VALID
  INVALID
}

enum AttachmentKind {
  CITIZEN_PHOTO
  INSPECTION_EVIDENCE
  // Photograph added with a citizen follow-up. Public once a moderator has checked it.
  FOLLOW_UP_PHOTO
  // Screenshot or scan of an official acknowledgment. Never public: it can carry personal details.
  OFFICIAL_ACKNOWLEDGMENT
}

enum ComplaintEventType {
  SUBMITTED
  STATUS_CHANGED
  OFFICER_ASSIGNED
  NOTE_ADDED
  EVIDENCE_UPLOADED
  FINDINGS_UPDATED
  VISIBILITY_CHANGED
  FOLLOW_UP_ADDED
  FOLLOW_UP_CHECKED
}

// What a citizen adds to a case after reporting it. None of these changes the AirWatch
// review status: they are the independent side of the record.
enum FollowUpKind {
  OFFICIAL_COMPLAINT   // filed with BMC through an official channel: reference, date, acknowledgment
  OFFICIAL_RESPONSE    // a reply or action from BMC, as received by the citizen
  STILL_UNRESOLVED     // observed on site: the dust persists
  IMPROVEMENT_OBSERVED // observed on site: conditions improved
  DISPUTE_CLOSURE      // disagrees with how AirWatch closed the case
  NOTE
}

// Whether a moderator has looked at a follow-up's evidence. VERIFIED means the evidence
// supports what the citizen states; it never means BMC confirmed anything to AirWatch.
enum EvidenceCheck {
  UNCHECKED
  VERIFIED
  SET_ASIDE
}

enum RepresentativeRole {
  CORPORATOR
  MLA
  MP
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CITIZEN)
  createdAt    DateTime @default(now())

  complaints         Complaint[]      @relation("ComplaintCitizen")
  assignedComplaints Complaint[]      @relation("ComplaintOfficer")
  events             ComplaintEvent[]
  attachments        Attachment[]
  registeredDevices  Device[]
  followUps          FollowUp[]       @relation("FollowUpAuthor")
  checkedFollowUps   FollowUp[]       @relation("FollowUpChecker")
}

// BMC administrative ward. Reference data: every fact comes from a cited public source
// (sourceUrls) checked on verifiedOn. Boundaries live in src/data/wardBoundaries.json.
model Ward {
  id              String    @id @default(cuid())
  code            String    @unique // as BMC writes it, for example "K/E"
  slug            String    @unique // URL-safe, for example "ke"
  name            String
  areas           String?
  // Something a citizen should know about this ward's administration, from a cited source.
  note            String?
  // Pilot wards have verified projects, demo monitors and accept citizen reports.
  pilot           Boolean   @default(false)
  latitude        Float?
  longitude       Float?
  officeAddress   String?
  officePhone     String?
  officeEmail     String?
  officeLatitude  Float?
  officeLongitude Float?
  sourceUrls      Json?
  verifiedOn      DateTime?

  localities      Locality[]
  representatives Representative[]
  projects        Project[]
  complaints      Complaint[]
}

// Elected representative for an area of a ward. Shown as a representative only:
// they are not an enforcement authority and receive nothing from this system.
model Representative {
  id           String             @id @default(cuid())
  wardId       String
  role         RepresentativeRole
  name         String
  party        String?
  constituency String
  note         String?
  sourceUrl    String
  verifiedOn   DateTime

  ward Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, role, constituency])
}

// A real construction project, from public records. Nothing here is measured or simulated.
model Project {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  developer           String?
  category            String
  authority           String // register or agency the record comes from: MahaRERA, MMRDA, BMC ...
  registrationNo      String?
  description         String?
  address             String?
  latitude            Float?
  longitude           Float?
  coordinateSource    String?
  coordinatePrecision String? // site | street | locality
  wardId              String
  proposedCompletion  String?
  status              String?
  statusConfidence    String?
  sourceUrls          Json
  verifiedOn          DateTime
  notes               String?
  active              Boolean  @default(true)

  ward       Ward        @relation(fields: [wardId], references: [id])
  site       Site?
  complaints Complaint[]

  @@index([wardId])
}

model Locality {
  id        String @id @default(cuid())
  code      String  @unique
  name      String
  city      String  @default("Mumbai")
  latitude  Float
  longitude Float
  // Inactive localities are kept for the complaints that reference them but are not monitored.
  active    Boolean @default(true)
  // The administrative ward this monitoring area belongs to.
  wardId    String?

  ward       Ward?       @relation(fields: [wardId], references: [id])
  stations   Station[]
  sites      Site[]
  complaints Complaint[]
}

// Background (reference) monitoring station.
model Station {
  id         String @id @default(cuid())
  code       String @unique
  name       String
  latitude   Float
  longitude  Float
  localityId String
  active     Boolean        @default(true)
  provenance DataProvenance @default(SIMULATED)
  operator   String?

  locality               Locality                @relation(fields: [localityId], references: [id])
  sites                  Site[]
  backgroundObservations BackgroundObservation[]
  weatherObservations    WeatherObservation[]
}

model Site {
  id                   String @id @default(cuid())
  code                 String @unique
  name                 String
  address              String
  latitude             Float
  longitude            Float
  localityId           String
  stationId            String
  // Geometry of the station -> site pair, used to derive model feature inputs.
  distanceToBackgroundM Float
  siteBearingDeg        Float
  active                Boolean @default(true)
  // Demonstration site: not a real construction project.
  simulated             Boolean @default(true)
  // The verified project this monitoring point stands at, when there is one.
  projectId             String? @unique

  project      Project?            @relation(fields: [projectId], references: [id])
  locality     Locality            @relation(fields: [localityId], references: [id])
  station      Station             @relation(fields: [stationId], references: [id])
  observations SensorObservation[]
  evaluations  AnomalyEvaluation[]
  complaints   Complaint[]
  simulator    SimulatorState?
  devices      Device[]
  readings     DeviceReading[]
}

// A registered monitor. Only a hash of its credential is stored.
model Device {
  id                      String         @id @default(cuid())
  deviceId                String         @unique
  siteId                  String
  manufacturer            String
  model                   String
  ownerName               String
  provenance              DataProvenance
  samplingIntervalSeconds Int            @default(60)
  status                  DeviceStatus   @default(ACTIVE)
  // Whether this device's readings may be shown on the citizen-facing dashboard.
  publishAllowed          Boolean        @default(false)
  calibratedAt            DateTime?
  calibrationNote         String?
  tokenHash               String         @unique
  tokenHint               String
  lastSeenAt              DateTime?
  lastReportedStatus      String?
  registeredById          String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  site         Site             @relation(fields: [siteId], references: [id])
  registeredBy User?            @relation(fields: [registeredById], references: [id])
  readings     DeviceReading[]
  batches      IngestionBatch[]

  @@index([siteId])
}

// One row per ingestion request, including what was refused and why.
model IngestionBatch {
  id         String   @id @default(cuid())
  deviceId   String
  receivedAt DateTime @default(now())
  received   Int
  accepted   Int
  duplicates Int
  rejected   Int
  rejections Json?

  device   Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  readings DeviceReading[]

  @@index([deviceId, receivedAt])
}

// Raw device telemetry, stored independently of any model evaluation.
model DeviceReading {
  id              String         @id @default(cuid())
  deviceId        String
  siteId          String
  batchId         String?
  observedAt      DateTime
  intervalSeconds Int
  pm25            Float?
  pm10            Float?
  temperatureC    Float?
  humidityPct     Float?
  unit            String
  pm25Ugm3        Float?
  pm10Ugm3        Float?
  reportedStatus  String?
  provenance      DataProvenance
  quality         ReadingQuality
  qualityReason   String?
  // The reading exactly as the device sent it.
  payload         Json
  receivedAt      DateTime       @default(now())

  device      Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  site        Site               @relation(fields: [siteId], references: [id])
  batch       IngestionBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  observation SensorObservation?

  // Makes retried uploads idempotent.
  @@unique([deviceId, observedAt, intervalSeconds])
  @@index([siteId, observedAt])
}

// Background (reference) PM10 as supplied by the background provider.
model BackgroundObservation {
  id              String         @id @default(cuid())
  stationId       String
  observedAt      DateTime
  intervalSeconds Int
  pm10            Float
  unit            String
  pm10Ugm3        Float?
  provenance      DataProvenance
  source          String
  instrument      String?
  receivedAt      DateTime       @default(now())

  station      Station             @relation(fields: [stationId], references: [id], onDelete: Cascade)
  observations SensorObservation[]

  @@unique([stationId, observedAt, intervalSeconds])
}

// Wind as supplied by the weather provider.
model WeatherObservation {
  id               String         @id @default(cuid())
  stationId        String
  observedAt       DateTime
  windSpeedMs      Float?
  windDirectionDeg Float?
  windConvention   String?
  provenance       DataProvenance
  source           String
  receivedAt       DateTime       @default(now())

  station      Station             @relation(fields: [stationId], references: [id], onDelete: Cascade)
  observations SensorObservation[]

  @@unique([stationId, observedAt])
}

// The pairing record: one site reading together with whatever background and
// weather context could be matched to it. Context fields are null when the
// corresponding source had nothing compatible; they are never filled in by guessing.
model SensorObservation {
  id                  String    @id @default(cuid())
  siteId              String
  dataSource          String
  pollutant           String
  averaging           String
  backgroundSensorId  String?
  backgroundValue     Float?
  backgroundUnit      String?
  backgroundTimestamp DateTime?
  siteSensorId        String
  siteValue           Float?
  siteUnit            String?
  siteTimestamp       DateTime
  backgroundUgm3      Float?
  siteUgm3            Float?
  sitePm25Ugm3        Float?
  intervalSeconds     Int?
  deviceReadingId         String? @unique
  backgroundObservationId String?
  weatherObservationId    String?
  backgroundSource        String?
  weatherSource           String?
  // Pairing facts: distance, bearing, time offsets and the provenance of each source.
  pairing                 Json?
  temperatureC        Float?
  humidityPct         Float?
  windSpeedMs         Float?
  windDirectionDeg    Float?
  windConvention      String?
  receivedAt          DateTime @default(now())

  site                  Site                   @relation(fields: [siteId], references: [id])
  evaluation            AnomalyEvaluation?
  deviceReading         DeviceReading?         @relation(fields: [deviceReadingId], references: [id], onDelete: SetNull)
  backgroundObservation BackgroundObservation? @relation(fields: [backgroundObservationId], references: [id], onDelete: SetNull)
  weatherObservation    WeatherObservation?    @relation(fields: [weatherObservationId], references: [id], onDelete: SetNull)

  @@index([siteId, receivedAt])
  @@index([siteId, siteTimestamp])
  @@index([receivedAt])
}

// One row per inference attempt. Verdict fields are only populated from a real
// FastAPI /predict response (status = EVALUATED).
model AnomalyEvaluation {
  id            String           @id @default(cuid())
  observationId String           @unique
  siteId        String
  status        EvaluationStatus
  reason        String?
  evaluatedAt   DateTime         @default(now())

  // Sensor values as sent to the model.
  backgroundValue     Float?
  siteValue           Float?
  unit                String?
  measurementType     String?
  scaleId             String?
  backgroundTimestamp DateTime?
  siteTimestamp       DateTime?
  features            Json?

  // Model response.
  observedDifference       Float?
  expectedNormalDifference Float?
  calibratedMargin         Float?
  dynamicBarrier           Float?
  isAnomaly                Boolean?
  interpretation           String?

  // Model identity at inference time.
  modelVersion       String?
  modelAlgorithm     String?
  modelDataSource    String?
  modelSyntheticOnly Boolean?
  // Model inputs that fell outside the range the model was trained on.
  domainWarnings     Json?

  observation SensorObservation @relation(fields: [observationId], references: [id])
  site        Site              @relation(fields: [siteId], references: [id])
  complaints  Complaint[]

  @@index([siteId, evaluatedAt])
  @@index([evaluatedAt])
  @@index([isAnomaly, evaluatedAt])
}

// Complaints are citizen reports. They may reference an anomaly evaluation as
// evidence but exist independently of it.
model Complaint {
  id           String          @id @default(cuid())
  seq          Int             @unique @default(autoincrement())
  citizenId    String
  localityId   String
  siteId       String?
  description  String
  latitude     Float?
  longitude    Float?
  locationText String?
  status       ComplaintStatus @default(SUBMITTED)

  // Evidence captured automatically at submission time.
  anomalyEvaluationId String?
  sensorSnapshot      Json?

  assignedOfficerId String?
  findings          String?
  correctiveAction  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Routing: the ward office responsible for the place, and the project named, if any.
  wardId       String?
  projectId    String?
  // Seeded demonstration history, never a real citizen's report.
  isDemo       Boolean @default(false)
  // Moderation: withheld from the public map by an officer, with the reason.
  publicHidden Boolean @default(false)
  hiddenReason String?

  ward              Ward?              @relation(fields: [wardId], references: [id])
  project           Project?           @relation(fields: [projectId], references: [id])
  citizen           User               @relation("ComplaintCitizen", fields: [citizenId], references: [id])
  assignedOfficer   User?              @relation("ComplaintOfficer", fields: [assignedOfficerId], references: [id])
  locality          Locality           @relation(fields: [localityId], references: [id])
  site              Site?              @relation(fields: [siteId], references: [id])
  anomalyEvaluation AnomalyEvaluation? @relation(fields: [anomalyEvaluationId], references: [id])
  attachments       Attachment[]
  events            ComplaintEvent[]
  followUps         FollowUp[]

  @@index([citizenId, createdAt])
  @@index([status, createdAt])
  @@index([localityId])
  @@index([siteId])
  @@index([wardId, status])
}

model Attachment {
  id           String         @id @default(cuid())
  complaintId  String
  uploadedById String
  kind         AttachmentKind
  filename     String
  mimeType     String
  sizeBytes    Int
  caption      String?
  data         Bytes
  createdAt    DateTime       @default(now())
  followUpId   String?

  complaint  Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id])
  followUp   FollowUp? @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([followUpId])
}

// One entry in a case's citizen-led evidence trail: an official complaint filed elsewhere,
// an official response received, or what a resident saw on site afterwards. Any signed-in
// citizen may add one to a public case, not only the person who reported it.
model FollowUp {
  id          String        @id @default(cuid())
  complaintId String
  authorId    String
  kind        FollowUpKind
  note        String?
  // When the citizen says it happened: the day the official complaint was filed or the
  // response arrived, or when the site was observed. createdAt is when it reached AirWatch.
  occurredOn  DateTime?
  // Where the citizen stood when adding it, if they shared their location.
  latitude    Float?
  longitude   Float?
  // Official complaint only.
  officialChannel   String?
  officialReference String?

  check       EvidenceCheck @default(UNCHECKED)
  checkNote   String?
  checkedById String?
  checkedAt   DateTime?
  // Seeded demonstration history, never a real citizen's entry.
  isDemo      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  complaint   Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  author      User         @relation("FollowUpAuthor", fields: [authorId], references: [id])
  checkedBy   User?        @relation("FollowUpChecker", fields: [checkedById], references: [id])
  attachments Attachment[]

  @@index([complaintId, createdAt])
  @@index([check])
}

// Append-only audit trail.
model ComplaintEvent {
  id          String             @id @default(cuid())
  complaintId String
  actorId     String
  type        ComplaintEventType
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus?
  note        String?
  metadata    Json?
  createdAt   DateTime           @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor     User      @relation(fields: [actorId], references: [id])

  @@index([complaintId, createdAt])
}

// Mock sensor scenario per site. Only read by the mock sensor provider.
model SimulatorState {
  siteId    String   @id
  scenario  String   @default("NORMAL")
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}
